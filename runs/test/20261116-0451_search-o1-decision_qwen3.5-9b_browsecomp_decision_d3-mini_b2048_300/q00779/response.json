                  "urls": [
                    "https://www.congress.gov/crs_external_products/RL/PDF/RL30127/RL30127.3.pdf"
                  ],
                  "anchor": "Kosovo Conflict Chronology: September 1998-March 1999",
                  "link_score": null,
                  "evidence_score": null,
