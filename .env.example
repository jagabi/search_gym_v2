# 도구 —— 검색과 페이지 읽기
SERPER_API_KEY="4f181e17d1e200cc97e555664b65bd7aee6d2709"
JINA_API_KEY=

# Serper 지역·언어 기본값. 한국어 벤치마크(kbrowsecomp)는 gl=kr, hl=ko 로 바꿔야
# 한국어 결과가 나온다. 안 바꾸면 영어 결과만 와서 점수가 바닥난다.
SEARCH_REGION=us
SEARCH_LANGUAGE=en

# --- Jina Reader 옵션 -------------------------------------------------------
# JINA_WITH_LINKS=1 이면 본문 끝에 페이지의 링크 목록이 붙는다.
# **depthsearch 는 이게 켜져 있어야 explorer 가 따라 들어갈 URL 을 볼 수 있다.**
# 대신 링크가 많은 페이지에서는 본문보다 링크가 길어져 정제기의 문서 예산을 먹는다.
# 켜기 전에 tests/fetch.py 로 실제 크기를 재 볼 것:
#   python tests/fetch.py <url>            # 링크 없이 몇 자인가
#   python tests/fetch.py <url> --links    # 켜면 몇 자가 되는가
JINA_WITH_LINKS=0
JINA_WITH_IMAGES=0
JINA_RETURN_FORMAT=markdown
JINA_ENGINE=

# serper 가 돌려주는 검색 결과 수. 상위 search_top_k 개만 자동 페치된다.
SEARCH_RESULTS=10

# 페치 비상 밸브(자). 기본 0 = 자르지 않고 날것 그대로 받는다.
# 토큰 단위 절단은 모델을 아는 에이전트가 한다 —
#   explorer.max_document_tokens / agent.context_limit (configs/<방법>.yaml)
# 병적으로 큰 페이지를 막아야 할 때만 값을 준다.
FETCH_MAX_CHARS=0

# 벤치마크 자체를 찾아가는 것을 막는다(Search-Time Contamination).
BLOCKED_TERMS=deepsearchqa,browsecomp,evobrowsecomp,kbrowsecomp,dsqa-full

# 판정 모델 (Gemini)
GOOGLE_API_KEY=

# 교사 모델 (GEPA reflection LM). configs/gepa.yaml 의 teacher.model 에 맞춘다.
ANTHROPIC_API_KEY=

# MCP 도구 서버를 원격으로 띄웠을 때만. 비우면 stdio 서브프로세스로 붙는다.
MCP_SERVER_URL=
MCP_AUTH_TOKEN=
