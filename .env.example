# 도구 —— 검색과 페이지 읽기
SERPER_API_KEY=
JINA_API_KEY=

# Serper 지역·언어 기본값. 한국어 벤치마크(kbrowsecomp)는 gl=kr, hl=ko 로 바꿔야
# 한국어 결과가 나온다. 안 바꾸면 영어 결과만 와서 점수가 바닥난다.
SEARCH_REGION=us
SEARCH_LANGUAGE=en

# 판정 모델 (Gemini)
GOOGLE_API_KEY=

# 교사 모델 (GEPA reflection LM). configs/train.yaml의 teacher.model에 맞춘다.
ANTHROPIC_API_KEY=

# MCP 도구 서버를 원격으로 띄웠을 때만. 비우면 stdio 서브프로세스로 붙는다.
MCP_SERVER_URL=
MCP_AUTH_TOKEN=
